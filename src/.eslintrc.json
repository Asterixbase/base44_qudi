{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "overrides": [
    {
      "files": ["**/__tests__/**/*.js", "**/*.test.js", "**/*.spec.js"],
      "env": {
        "jest": true
      }
    }
  ]
}