{
  "name": "PurchaseOrder",
  "type": "object",
  "properties": {
    "po_number": {
      "type": "string",
      "title": "PO Number"
    },
    "product_id": {
      "type": "string",
      "title": "Product ID"
    },
    "product_sku": {
      "type": "string",
      "title": "Product SKU"
    },
    "product_name": {
      "type": "string",
      "title": "Product Name"
    },
    "vendor_name": {
      "type": "string",
      "title": "Vendor Name"
    },
    "vendor_contact": {
      "type": "string",
      "title": "Vendor Contact"
    },
    "quantity": {
      "type": "number",
      "title": "Order Quantity"
    },
    "unit_price": {
      "type": "number",
      "title": "Unit Price (GHS)"
    },
    "total_amount": {
      "type": "number",
      "title": "Total Amount (GHS)"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "confirmed",
        "shipped",
        "received",
        "cancelled"
      ],
      "title": "Status"
    },
    "reorder_date_predicted": {
      "type": "string",
      "title": "Predicted Reorder Date (ISO)"
    },
    "expected_delivery_date": {
      "type": "string",
      "title": "Expected Delivery Date (ISO)"
    },
    "actual_delivery_date": {
      "type": "string",
      "title": "Actual Delivery Date (ISO)"
    },
    "tracking_number": {
      "type": "string",
      "title": "Tracking Number"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "auto_generated": {
      "type": "boolean",
      "title": "Auto-generated by System"
    }
  },
  "required": [
    "product_id",
    "product_name",
    "vendor_name",
    "quantity",
    "status"
  ]
}