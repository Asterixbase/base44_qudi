{
  "name": "Dispute",
  "type": "object",
  "properties": {
    "circle_id": {
      "type": "string",
      "title": "Circle ID"
    },
    "member_id": {
      "type": "string",
      "title": "Member ID"
    },
    "member_name": {
      "type": "string",
      "title": "Member Name"
    },
    "dispute_type": {
      "type": "string",
      "enum": [
        "payment_status",
        "suspicious_transaction",
        "missed_payout"
      ],
      "title": "Dispute Type"
    },
    "reported_status": {
      "type": "string",
      "title": "Incorrectly Reported Status"
    },
    "claimed_status": {
      "type": "string",
      "enum": [
        "paid",
        "pending",
        "failed",
        "overdue"
      ],
      "title": "Member's Claimed Status"
    },
    "transaction_ref": {
      "type": "string",
      "title": "Suspicious Transaction Ref / MoMo Ref"
    },
    "flagged_amount": {
      "type": "number",
      "title": "Flagged Amount (GHS)"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "proof_url": {
      "type": "string",
      "title": "Proof of Payment URL"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "under_review",
        "escrow_held",
        "resolved",
        "rejected"
      ],
      "title": "Dispute Status"
    },
    "escrow_held": {
      "type": "boolean",
      "title": "Funds in Escrow"
    },
    "escrow_amount": {
      "type": "number",
      "title": "Escrowed Amount (GHS)"
    },
    "organiser_note": {
      "type": "string",
      "title": "Organiser Note"
    },
    "cycle": {
      "type": "number",
      "title": "Cycle Number"
    },
    "resolution": {
      "type": "string",
      "title": "Resolution Action"
    }
  },
  "required": [
    "circle_id",
    "member_name",
    "dispute_type",
    "status"
  ]
}