{
  "name": "Circle",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Circle Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "contribution_amount": {
      "type": "number",
      "title": "Contribution Amount (GHS)"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "weekly",
        "monthly"
      ],
      "title": "Frequency"
    },
    "max_members": {
      "type": "number",
      "title": "Max Members"
    },
    "status": {
      "type": "string",
      "enum": [
        "forming",
        "active",
        "completed"
      ],
      "title": "Status"
    },
    "current_cycle": {
      "type": "number",
      "title": "Current Cycle"
    },
    "payout_order": {
      "type": "string",
      "enum": [
        "random",
        "fixed",
        "rotation",
        "bid"
      ],
      "title": "Payout Order"
    },
    "guarantor_policy": {
      "type": "string",
      "enum": [
        "required",
        "optional",
        "none"
      ],
      "title": "Guarantor Policy"
    },
    "pot_balance": {
      "type": "number",
      "title": "Pot Balance (GHS)"
    },
    "organiser_id": {
      "type": "string",
      "title": "Organiser User ID"
    },
    "is_insured": {
      "type": "boolean",
      "title": "Insured"
    },
    "penalty_enabled": {
      "type": "boolean",
      "title": "Penalties Enabled"
    },
    "penalty_type": {
      "type": "string",
      "enum": [
        "flat_fee",
        "percentage",
        "daily_interest"
      ],
      "title": "Penalty Type"
    },
    "penalty_flat_fee": {
      "type": "number",
      "title": "Flat Fee Amount (GHS)"
    },
    "penalty_percentage": {
      "type": "number",
      "title": "Penalty % of Contribution"
    },
    "penalty_daily_rate": {
      "type": "number",
      "title": "Daily Interest Rate (%)"
    },
    "penalty_grace_days": {
      "type": "number",
      "title": "Grace Period (days)"
    },
    "penalty_notify_guarantor": {
      "type": "boolean",
      "title": "Notify Guarantor on Penalty"
    }
  },
  "required": [
    "name",
    "contribution_amount",
    "frequency",
    "max_members"
  ]
}