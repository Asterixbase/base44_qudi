{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "title": "Product ID"
    },
    "product_name": {
      "type": "string",
      "title": "Product Name"
    },
    "type": {
      "type": "string",
      "enum": [
        "in",
        "out",
        "adjustment",
        "damage"
      ],
      "title": "Transaction Type"
    },
    "quantity": {
      "type": "number",
      "title": "Quantity"
    },
    "reference": {
      "type": "string",
      "title": "Reference (PO/Sales Ref)"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "pending",
        "synced"
      ],
      "title": "Sync Status"
    }
  },
  "required": [
    "product_id",
    "product_name",
    "type",
    "quantity"
  ]
}